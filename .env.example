# ==============================================================================
# GradeSense AI — Root Environment Configuration (.env.example)
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=production
PROJECT_NAME="GradeSense AI"
LOG_LEVEL=INFO

# PostgreSQL Database Configuration
POSTGRES_USER=gradesense_user
POSTGRES_PASSWORD=gradesense_secret_password
POSTGRES_DB=gradesense_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://gradesense_user:gradesense_secret_password@postgres:5432/gradesense_db

# Security & Authentication
SECRET_KEY=super_secret_jwt_key_for_industrial_gradesense_ai_2026_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Redis Cache & Background Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS & Domain Boundaries
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,https://gradesense.mill.plant.internal

# Next.js Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
